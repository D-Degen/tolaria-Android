{
  "$schema": "https://json.schemastore.org/eas.json",
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "alpha",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "stable",
      "autoIncrement": true
    },
    "ota-validation": {
      "distribution": "internal",
      "channel": "ota-validation"
    }
  },
  "submit": {
    "production": {}
  }
}
