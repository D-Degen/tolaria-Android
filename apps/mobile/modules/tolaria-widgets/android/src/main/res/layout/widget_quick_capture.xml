<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="horizontal"
  android:gravity="center_vertical"
  android:padding="8dp"
  android:background="@drawable/widget_bg">

  <!-- Logo and App Name -->
  <LinearLayout
    android:id="@+id/btn_open_app"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Tolaria"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="#1F2328" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Quick Capture"
      android:textSize="11sp"
      android:textColor="#57606A" />
  </LinearLayout>

  <!-- Button: New Note -->
  <ImageButton
    android:id="@+id/btn_new_note"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/widget_btn_bg"
    android:src="@drawable/ic_widget_add"
    android:contentDescription="@string/widget_new_note"
    android:scaleType="centerInside" />

  <!-- Button: Voice Capture -->
  <ImageButton
    android:id="@+id/btn_voice_note"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/widget_btn_bg"
    android:src="@drawable/ic_widget_mic"
    android:contentDescription="@string/widget_voice_note"
    android:scaleType="centerInside" />

  <!-- Button: Search -->
  <ImageButton
    android:id="@+id/btn_search"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/widget_btn_bg"
    android:src="@drawable/ic_widget_search"
    android:contentDescription="@string/widget_search"
    android:scaleType="centerInside" />

  <!-- Button: Inbox -->
  <ImageButton
    android:id="@+id/btn_inbox"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/widget_btn_bg"
    android:src="@drawable/ic_widget_inbox"
    android:contentDescription="@string/widget_inbox"
    android:scaleType="centerInside" />

</LinearLayout>
